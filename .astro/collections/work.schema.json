{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "client": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "affiliate": {
      "type": "string"
    },
    "searchTerm": {
      "type": "string"
    },
    "searchLink": {
      "type": "string"
    },
    "launchDate": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string"
    },
    "imgPath": {
      "type": "string"
    },
    "logo": {
      "type": "string"
    },
    "emblem": {
      "type": "string"
    },
    "photoFeatured": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "img": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "size": {
            "type": "string"
          }
        },
        "required": [
          "img",
          "title",
          "size"
        ]
      }
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "client",
    "tagline",
    "searchTerm",
    "searchLink",
    "launchDate",
    "scope",
    "imgPath",
    "logo",
    "emblem",
    "photoFeatured",
    "photos"
  ]
}